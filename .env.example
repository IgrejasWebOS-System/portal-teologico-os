# ============================================================
# .env.example — portal-teologico-os
#
# Copie este arquivo para .env.local e preencha com os valores
# reais do seu ambiente. NUNCA coloque valores reais aqui neste
# arquivo (.env.example é versionado no git).
# ============================================================

# --- Supabase --------------------------------------------------
# Painel do projeto -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Aba "service_role" em Settings -> API Keys. NUNCA expor ao
# browser — usada só em código server-side (utils/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---------------------------------------------------------
# URL base do app (usada em back_urls do Mercado Pago, links de
# e-mail, etc). Em produção, deve ser https:// (obrigatório para o
# Mercado Pago aceitar auto_return na preferência de checkout).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Mercado Pago (Checkout Pro) ---------------------------------
# Developers -> sua aplicação -> Credenciais. Use o Access Token de
# TESTE (começa com TEST-) em desenvolvimento. Nunca commitar a
# credencial de produção.
MERCADOPAGO_ACCESS_TOKEN=
# Secret de assinatura do webhook (Developers -> sua aplicação ->
# Webhooks -> "Assinatura secreta"). Usado para validar que a
# notificação em /api/webhooks/mercadopago realmente veio do
# Mercado Pago (header x-signature).
MERCADOPAGO_WEBHOOK_SECRET=

# --- Resend (e-mail transacional) --------------------------------
# https://resend.com -> API Keys. Opcional: sem essa chave, o envio
# de convite "vire aluno" só é pulado (log de aviso), nada quebra.
RESEND_API_KEY=
# Remetente. Enquanto o domínio do CETADP não estiver verificado no
# Resend, use o domínio de teste deles (onboarding@resend.dev).
RESEND_FROM_EMAIL=CETADP <onboarding@resend.dev>
